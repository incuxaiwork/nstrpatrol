# PostgreSQL connection string (PostGIS enabled)
DATABASE_URL="postgresql://nstrpatrol:nstrpatrol@localhost:5434/nstrpatrol?schema=public"

# Server
PORT=3000

# S3-compatible object storage (optional).
# When S3_BUCKET is set, uploads are stored in S3 instead of the local
# STORAGE_DIR. This is REQUIRED on Railway, whose filesystem is ephemeral.
# Leave these unset for local disk storage (STORAGE_DIR).
# S3_BUCKET=your-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.railway.app
# S3_ACCESS_KEY=...
# S3_SECRET=...
