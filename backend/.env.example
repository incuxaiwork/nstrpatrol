# PostgreSQL connection string (PostGIS enabled)
DATABASE_URL="postgresql://nstrpatrol:nstrpatrol@localhost:5434/nstrpatrol?schema=public"

# Server
PORT=3000

# S3-compatible object storage (Railway storage). Omit to fall back to local STORAGE_DIR.
# S3_ENDPOINT accepts host-only ("t3.storageapi.dev") or full URL ("https://t3.storageapi.dev");
# SSL is inferred from the scheme (or set S3_USE_SSL explicitly).
S3_ENDPOINT="https://t3.storageapi.dev"
S3_PORT=443
S3_USE_SSL="true"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Alias for S3_SECRET_KEY — either name works.
# S3_SECRET=""
S3_BUCKET=""
