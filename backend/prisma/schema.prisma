generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  fullName          String
  role              Role       @default(RANGER)
  phone             String?
  refreshTokenHash  String?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  cader             Cader
  isAdmin           Boolean    @default(false)
  devices           Device[]
  incidents         Incident[]
  verifiedIncidents Incident[] @relation("VerifiedBy")
  patrols           Patrol[]
}

model Device {
  id                String    @id @default(cuid())
  userId            String
  deviceName        String
  deviceModel       String
  deviceId          String    @unique
  pushToken         String?
  faceVerifiedAt    DateTime?
  facePhotoKey      String?
  verificationMode  String?
  verifiedByUserId  String?
  faceEmbedding     String?
  lastMatchScore    Float?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])
}

model Forest {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  boundaries  ForestBoundary[]
  grids       ForestGrid[]
  patrols     Patrol[]
}

model ForestBoundary {
  id        String                   @id @default(cuid())
  forestId  String
  name      String
  geom      Unsupported("geometry")?
  createdAt DateTime                 @default(now())
  forest    Forest                   @relation(fields: [forestId], references: [id])

  @@index([forestId])
  @@index([geom], type: Gist)
}

model ForestGrid {
  id           String                   @id @default(cuid())
  forestId     String
  gridCode     String
  geom         Unsupported("geometry")?
  createdAt    DateTime                 @default(now())
  forest       Forest                   @relation(fields: [forestId], references: [id])
  patrolPoints PatrolPoint[]

  @@index([forestId])
  @@index([geom], type: Gist)
}

model Patrol {
  id                    String                 @id @default(cuid())
  forestId              String
  name                  String?
  description           String?
  type                  PatrolType
  status                PatrolStatus           @default(ACTIVE)
  startedAt             DateTime?
  endedAt               DateTime?
  syncStatus            SyncStatus             @default(PENDING)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userId                String
  patrolMethod          String?
  beat                  String?
  armedStatus           String?
  caloriesEstimate      Float?
  heartPointsEstimate   Float?
  avgSpeedKmh           Float?
  detectedMethod        String?
  faceVerified          Boolean                @default(false)
  faceMatchScore        Float?
  accelerometerReadings AccelerometerReading[]
  activitySegments      ActivitySegment[]
  barometerReadings     BarometerReading[]
  coverageEvents        CoverageEvent[]
  gyroscopeReadings     GyroscopeReading[]
  incidents             Incident[]
  magnetometerReadings  MagnetometerReading[]
  forest                Forest                 @relation(fields: [forestId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  points                PatrolPoint[]
  stepReadings          StepReading[]
  movementModeReadings  MovementModeReading[]
  integrityLogs         TimeIntegrityLog[]

  @@index([userId])
  @@index([forestId])
  @@index([status])
}

model PatrolPoint {
  id         String                   @id @default(cuid())
  gridId     String?
  latitude   Float
  longitude  Float
  altitude   Float?
  speed      Float?
  bearing    Float?
  accuracy   Float?
  geom       Unsupported("geometry")?
  timestamp  DateTime
  syncStatus SyncStatus               @default(PENDING)
  createdAt  DateTime                 @default(now())
  patrolId   String
  grid       ForestGrid?              @relation(fields: [gridId], references: [id])
  patrol     Patrol                   @relation(fields: [patrolId], references: [id])

  @@index([geom], type: Gist)
  @@index([patrolId, timestamp])
}

model StepReading {
  id         String     @id @default(cuid())
  timestamp  DateTime
  steps      Int
  cadence    Float?
  syncStatus SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  patrolId   String
  patrol     Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model MovementModeReading {
  id         String     @id @default(cuid())
  timestamp  DateTime
  mode       String
  confidence Float?
  speedKmh   Float?
  syncStatus SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  patrolId   String
  patrol     Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model BarometerReading {
  id          String     @id @default(cuid())
  timestamp   DateTime
  pressureHpa Float
  altitudeM   Float?
  syncStatus  SyncStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  patrolId    String
  patrol      Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model AccelerometerReading {
  id         String     @id @default(cuid())
  timestamp  DateTime
  x          Float?
  y          Float?
  z          Float?
  syncStatus SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  patrolId   String
  patrol     Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model GyroscopeReading {
  id         String     @id @default(cuid())
  timestamp  DateTime
  x          Float?
  y          Float?
  z          Float?
  syncStatus SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  patrolId   String
  patrol     Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model MagnetometerReading {
  id         String     @id @default(cuid())
  timestamp  DateTime
  x          Float?
  y          Float?
  z          Float?
  syncStatus SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  patrolId   String
  patrol     Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model ActivitySegment {
  id         String       @id @default(cuid())
  mode       ActivityMode
  startTime  DateTime
  endTime    DateTime
  confidence Float?
  syncStatus SyncStatus   @default(PENDING)
  createdAt  DateTime     @default(now())
  patrolId   String
  patrol     Patrol       @relation(fields: [patrolId], references: [id])

  @@index([patrolId, startTime])
}

model CoverageEvent {
  id         String       @id @default(cuid())
  type       CoverageType
  latitude   Float?
  longitude  Float?
  timestamp  DateTime
  syncStatus SyncStatus   @default(PENDING)
  createdAt  DateTime     @default(now())
  patrolId   String
  patrol     Patrol       @relation(fields: [patrolId], references: [id])

  @@index([patrolId, type])
}

model TimeIntegrityLog {
  id                String     @id @default(cuid())
  timestamp         DateTime
  gnssTimeAvailable Boolean
  divergenceSeconds Int
  autoTimeEnabled   Boolean
  tamperDetected    Boolean
  satellites        Int
  syncStatus        SyncStatus @default(PENDING)
  createdAt         DateTime   @default(now())
  patrolId          String
  patrol            Patrol     @relation(fields: [patrolId], references: [id])

  @@index([patrolId, timestamp])
}

model Incident {
  id             String                   @id @default(cuid())
  userId         String
  type           IncidentType
  title          String
  description    String?
  severity       IncidentSeverity         @default(LOW)
  status         IncidentStatus           @default(SUBMITTED)
  details        Json?
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  geom           Unsupported("geometry")?
  photos         String[]
  occurredAt     DateTime
  reportedAt     DateTime
  syncStatus     SyncStatus               @default(PENDING)
  verifiedById   String?
  verifiedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  patrolId       String?
  patrol         Patrol?                  @relation(fields: [patrolId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  verifiedBy     User?                    @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([geom], type: Gist)
  @@index([patrolId])
  @@index([userId])
  @@index([verifiedById])
  @@index([status])
  @@index([occurredAt])
}

model Beat {
  id           String                   @id @default(cuid())
  name         String
  section      String?
  rangeName    String?
  division     String?
  circle       String?
  district     String?
  areaHa       Float?
  geom         Unsupported("geometry")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  compartments Compartment[]
  routes       PatrolRoute[]

  @@index([geom], type: Gist)
  @@index([name])
}

model Compartment {
  id        String                   @id @default(cuid())
  beatId    String?
  compNo    String
  areaHa    Float?
  geom      Unsupported("geometry")?
  createdAt DateTime                 @default(now())
  beat      Beat?                    @relation(fields: [beatId], references: [id])

  @@index([geom], type: Gist)
  @@index([beatId])
}

model PatrolRoute {
  id         String                   @id @default(cuid())
  beatId     String?
  patrolType String?
  name       String
  geom       Unsupported("geometry")?
  targetKm   Float?
  active     Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  beat       Beat?                    @relation(fields: [beatId], references: [id])

  @@index([geom], type: Gist)
  @@index([beatId])
}

model MapAsset {
  id          String   @id @default(cuid())
  resourceKey String   @unique
  contentType String
  storagePath String?
  sizeBytes   Int
  sha256      String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  data        Bytes?
}

model SyncLog {
  id           String    @id @default(cuid())
  deviceId     String?
  patrolId     String?
  recordsCount Int
  status       String
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
}

model AppOption {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  ADMIN
  RANGER
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PatrolType {
  WALK
  BICYCLE
  VEHICLE
  STATIONARY
}

enum PatrolStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IncidentType {
  HUMAN_IMPACT
  ANIMAL_MORTALITY
  SIGHTING
  WATER_SOURCE
  QUICK_CAPTURE
  GENERAL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  SUBMITTED
  VERIFIED
  RESOLVED
  REJECTED
}

enum ActivityMode {
  WALK
  BICYCLE
  VEHICLE
  STATIONARY
}

enum CoverageType {
  OUTSIDE_BEAT
  NON_FOREST
  OFF_ROUTE
  SPEED_MISMATCH
  JUMP
  WAYPOINT_MISSED
  MOCK_LOCATION
  DEVICE_STATIONARY
  TIME_TAMPER
}

enum Cader {
  FRO
  DyRO
  FSO
  FBO
  ABO
}
